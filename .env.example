# LLM Configuration
LLM_PROVIDER=openai                   # openai | anthropic | mock (mock is for dev/testing only)
LLM_API_KEY=sk-...
LLM_MODEL_COMPLEX=gpt-4o             # Complex tasks: decompose, evidence weighing
LLM_MODEL_STANDARD=gpt-4o-mini       # Structured tasks: rank, query gen, verdict, synthesis
# Anthropic example: claude-sonnet-4-6 / claude-haiku-4-5-20251001

# Search Configuration
SEARCH_PROVIDER=serper                # serper | mock (mock is for dev/testing only)
SEARCH_API_KEY=...

# Application
MAX_CLAIMS=5                          # Max claims to verify per run
MAX_SOURCES_PER_CLAIM=5               # Max search results per query (each claim gets several queries)
LOG_LEVEL=info
